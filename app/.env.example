# Cue glasses app config. Copy to .env.local and fill in. Never commit .env.local.
# These are NOT third-party API keys. All real keys live in backend/.env only.

# Backend origin, no trailing slash. Leave empty to run the mic test offline (stats only).
# Dev on the phone: use your laptop's LAN IP, e.g. http://192.168.1.23:8787 (not localhost; localhost is the phone).
VITE_BACKEND_URL=

# Shared bearer token the backend reads from DEVICE_TOKEN (01-architecture section 4).
VITE_DEVICE_TOKEN=replace-with-device-token

# Mock briefs: unset/auto = fall back to a sample brief when STT or the brief backend has no keys;
# 1 = always mock (no network); 0 = never mock. ?mock=0|1 in the URL overrides this.
VITE_MOCK=
