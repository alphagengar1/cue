# Copy to backend/.env and fill in. Never commit .env. Never put keys in the glasses app.
PORT=8787

# Bearer token the glasses app and setup page send (Authorization: Bearer <token>).
# Leave empty only for local dev (auth is then off). The app gets the same value as VITE_DEVICE_TOKEN.
DEVICE_TOKEN=change-me

# Speech-to-text (Deepgram nova-3 prerecorded)
DEEPGRAM_API_KEY=your-deepgram-key

# Search (Exa)
EXA_API_KEY=your-exa-key

# Fast brief writer (Anthropic). Default model: claude-haiku-5-5, effort low.
ANTHROPIC_API_KEY=your-anthropic-key
# Only if your key is not scoped to a workspace (console.anthropic.com > Workspaces)
ANTHROPIC_WORKSPACE_ID=
BRIEF_MODEL=claude-haiku-5-5

# CREAO agents (design/creao-api-notes.md, agents/*.md). Account API key cr_sk_... from developer.creao.ai -> API Keys.
# agent_id values: Developer Console -> Agents, or `npm run creao:test -- --list`. Runs only start when key + id are set.
CREAO_API_KEY=cr_sk_your-creao-key
CREAO_EVENT_LOADER_ID=
CREAO_PERSON_RESEARCHER_ID=
CREAO_BRIEF_WRITER_ID=
# Public https base URL of this backend, for the CREAO webhook (e.g. https://api.cue.example).
# Leave empty in local dev: CREAO rejects localhost webhooks, and the backend polls every 15 s instead.
PUBLIC_BASE_URL=

# Sentry (tracing + Sentry Logs + errors). Off when empty. Node project DSN from sentry.io.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1

# Optional tuning
# STT_TIMEOUT_MS=4000
# SEARCH_TIMEOUT_MS=1500
# LLM_TIMEOUT_MS=4500
# LOOKUPS_PER_MINUTE=30

# Photon (Spectrum) iMessage recap. Optional; recap is skipped until all three are set.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
WEARER_PHONE=+1XXXXXXXXXX

# Decision gate (agents/decision-gate.md): OpenAI Decisions API, gpt-6-luna. Off without the key.
OPENAI_API_KEY=
DECIDE_TIMEOUT_MS=1200

# Demo event file, relative to backend/ (the setup page can switch events at runtime)
# SAMPLE_EVENT_FILE=data/creao-lahacks-sponsors.json

# CREAO per-agent app keys (agent detail page -> API, start with capi_). Runs use CREAO credits.
# Agent ids default to the Cue agents in README.md; override with CREAO_<AGENT>_ID.
CREAO_PERSON_RESEARCHER_KEY=
CREAO_FOLLOW_UP_WRITER_KEY=
CREAO_FOLLOW_UP_WRITER_ID=
CREAO_EVENT_LOADER_KEY=
CREAO_BRIEF_WRITER_KEY=

CREAO_MEETING_SCHEDULER_KEY=
CREAO_MEETING_SCHEDULER_ID=
CREAO_NETWORKING_COACH_KEY=
CREAO_NETWORKING_COACH_ID=
# Meeting proposals are made in this timezone
WEARER_TIMEZONE=America/Los_Angeles

# Google Calendar for the Meeting Scheduler (backend/src/calendar.ts, agents/meeting-scheduler.md).
# Off until all three are set. OAuth client (type Desktop app) from console.cloud.google.com with the
# Google Calendar API enabled; the refresh token comes from `npm run google:auth`, signed in as the wearer.
# The backend reads free/busy for the next 10 days, feeds the free windows to the agent, drops proposed
# times that collide, and places a tentative 30-minute hold on the wearer's own calendar (no attendees).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# Hours the wearer would take a call, local time; weekends are skipped unless WEARER_WEEKENDS=1
# WEARER_HOURS=10-18
